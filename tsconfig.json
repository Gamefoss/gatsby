{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@styles/*": ["./src/styles/*"],
      "@images/*": ["./src/images/*"],
      "@components": ["./src/components/index"],
      "@layouts": ["./src/layouts/index"],
      "@constants": ["./src/constants"],
      "@mocks/*": ["./__mocks__/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*", "./gatsby-node.ts", "./gatsby-config.ts", "./plugins/**/*", "./setup-test-env.ts"]
}
